rules_version = '2';

// Reglas de seguridad de Cloud Firestore.
// Se publican en Firebase Console → Firestore Database → Reglas.
// Subirlas a GitHub o desplegar en Vercel NO las activa.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- directorio de personas ----------
    // usuarios/{uid} = { email, nombre }
    // Guarda solo lo mínimo para poder invitar a alguien a una entrega.
    match /usuarios/{uid} {
      // Cualquiera con sesión iniciada puede buscar a otra persona por su email.
      // Hace falta para compartir: sin esto no habría forma de encontrar a quién invitar.
      // Por eso en este documento no se guarda nada más que el email y el nombre.
      allow read: if request.auth != null;

      // Cada persona escribe únicamente su propia ficha.
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------- datos privados de cada persona ----------
    // Preferencias (vista favorita, horas por día) y las entregas viejas de v1/v2,
    // que quedan como respaldo después de la migración.
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- entregas compartidas ----------
    // tareas/{id} lleva su propia lista de miembros. Entra quien esté en la lista.
    match /tareas/{id} {

      function esMiembro() {
        return request.auth != null && request.auth.uid in resource.data.miembros;
      }

      // Tiene una solicitud pendiente para sumarse (v3.1)
      function esInvitado() {
        return request.auth != null && request.auth.uid in resource.data.get('invitados', []);
      }

      // La persona invitada solo puede RESPONDER su propia solicitud:
      //   - se saca a sí misma de "invitados" (y de invitadosInfo)
      //   - y, si acepta, se suma a sí misma a "miembros" (y a miembrosInfo)
      // No puede tocar nada más de la entrega ni sumar o sacar a otras personas.
      function respondeSuInvitacion() {
        let yo = request.auth.uid;
        let antes = resource.data;
        let despues = request.resource.data;
        return despues.diff(antes).affectedKeys().hasOnly(['invitados', 'invitadosInfo', 'miembros', 'miembrosInfo'])
          && despues.get('invitados', []).toSet() == antes.get('invitados', []).toSet().difference([yo].toSet())
          && despues.get('invitadosInfo', {}).diff(antes.get('invitadosInfo', {})).affectedKeys().hasOnly([yo])
          && despues.get('miembrosInfo', {}).diff(antes.get('miembrosInfo', {})).affectedKeys().hasOnly([yo])
          && (despues.miembros.toSet() == antes.miembros.toSet()                          // rechazó
              || despues.miembros.toSet() == antes.miembros.toSet().union([yo].toSet())); // aceptó
      }

      // LEER: los miembros, y también quien fue invitado (para ver de qué se trata la solicitud).
      allow read: if esMiembro() || esInvitado();

      // CREAR: hay que anotarse como propietario y como miembro.
      // Así nadie puede crear una entrega a nombre de otro.
      allow create: if request.auth != null
                    && request.resource.data.propietario == request.auth.uid
                    && request.auth.uid in request.resource.data.miembros
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() > 0;

      // MODIFICAR: cualquier miembro puede editar la entrega (ese es el punto de compartirla),
      // pero con tres límites:
      //   - no se puede cambiar quién es el propietario
      //   - no se puede dejar al propietario afuera de la lista de miembros
      //   - no se pueden AGREGAR miembros a mano: solo invitar. Se entra aceptando la solicitud.
      // Además, la persona invitada puede responder su solicitud (ver respondeSuInvitacion).
      allow update: if (esMiembro()
                        && request.resource.data.propietario == resource.data.propietario
                        && resource.data.propietario in request.resource.data.miembros
                        && request.resource.data.miembros.toSet().difference(resource.data.miembros.toSet()).size() == 0)
                    || (esInvitado() && respondeSuInvitacion());

      // ELIMINAR: solo el propietario. Los demás pueden salirse (eso es un update),
      // pero no borrarle la entrega a otro.
      allow delete: if request.auth != null && request.auth.uid == resource.data.propietario;
    }

    // Todo lo que no esté permitido arriba queda bloqueado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
