rules_version = '2';

// Reglas de seguridad de Cloud Firestore.
// Se publican en Firebase Console → Firestore Database → Reglas.
// Subirlas a GitHub o desplegar en Vercel NO las activa.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- directorio de personas ----------
    // usuarios/{uid} = { email, nombre }
    // Guarda solo lo mínimo para poder invitar a alguien a una entrega.
    match /usuarios/{uid} {
      // Cualquiera con sesión iniciada puede buscar a otra persona por su email.
      // Hace falta para compartir: sin esto no habría forma de encontrar a quién invitar.
      // Por eso en este documento no se guarda nada más que el email y el nombre.
      allow read: if request.auth != null;

      // Cada persona escribe únicamente su propia ficha.
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---------- datos privados de cada persona ----------
    // Preferencias (vista favorita, horas por día) y las entregas viejas de v1/v2,
    // que quedan como respaldo después de la migración.
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- entregas compartidas ----------
    // tareas/{id} lleva su propia lista de miembros. Entra quien esté en la lista.
    match /tareas/{id} {

      function esMiembro() {
        return request.auth != null && request.auth.uid in resource.data.miembros;
      }

      // LEER: solo los miembros de la entrega.
      allow read: if esMiembro();

      // CREAR: hay que anotarse como propietario y como miembro.
      // Así nadie puede crear una entrega a nombre de otro.
      allow create: if request.auth != null
                    && request.resource.data.propietario == request.auth.uid
                    && request.auth.uid in request.resource.data.miembros
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() > 0;

      // MODIFICAR: cualquier miembro puede editar la entrega (ese es el punto de compartirla),
      // pero con dos límites:
      //   - no se puede cambiar quién es el propietario
      //   - no se puede dejar al propietario afuera de la lista de miembros
      allow update: if esMiembro()
                    && request.resource.data.propietario == resource.data.propietario
                    && resource.data.propietario in request.resource.data.miembros;

      // ELIMINAR: solo el propietario. Los demás pueden salirse (eso es un update),
      // pero no borrarle la entrega a otro.
      allow delete: if request.auth != null && request.auth.uid == resource.data.propietario;
    }

    // Todo lo que no esté permitido arriba queda bloqueado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
